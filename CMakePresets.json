{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "description": "MSVC with vcpkg. Run from a Visual Studio developer environment (cl and ninja on PATH) with VCPKG_ROOT set, or add machine paths in a CMakeUserPresets.json preset that inherits this one.",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/cmake-build-visual-studio-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/cmake-build-visual-studio-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wsl-clang-debug",
      "displayName": "WSL Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug-wsl-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "wsl-clang-release",
      "displayName": "WSL Clang Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release-wsl-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "wsl-clang-debug",
      "configurePreset": "wsl-clang-debug"
    },
    {
      "name": "wsl-clang-release",
      "configurePreset": "wsl-clang-release"
    }
  ]
}
